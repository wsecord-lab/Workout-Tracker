{
  "name": "workout-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "prisma migrate deploy && prisma db seed && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:backup": "npx tsx scripts/backup-db.ts",
    "fix:migration": "npx tsx scripts/fixMigration.ts",
    "db:backup:install": "./scripts/install-nightly-backup.sh",
    "create:trainer": "tsx scripts/create-trainer.ts",
    "mcp": "tsx mcp/src/index.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.12",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.4",
    "recharts": "^3.7.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.4.2",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "rimraf": "^5.0.0",
    "glob": "^13.0.0",
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3"
  }
}
