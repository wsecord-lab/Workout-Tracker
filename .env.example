# Required: PostgreSQL connection string (e.g. from Neon or Supabase).
# On Neon, prefer the pooled connection for serverless/runtime.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Direct (non-pooled) connection for Prisma migrations — same as DATABASE_URL if you are not using a pooler.
# On Neon: dashboard → connection details → use the "direct" or non-pooled URI here to avoid P1002 advisory lock timeouts during migrate deploy.
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional: Shared secret for access gate. If set in production, all requests must include
# header "x-access-token: <value>" or cookie "access_token=<value>"
# ACCESS_TOKEN=""

# Auth (NextAuth): required in production. Optional locally (dev fallback exists).
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Optional: set for local preview if redirects fail (use your dev server port)
# AUTH_URL="http://localhost:3000"

# MCP (Cursor / Claude Desktop) — which trainer the AI tools act as
# WORKOUT_TRACKER_TRAINER_EMAIL="you@example.com"
# WORKOUT_TRACKER_TRAINER_ID=""
