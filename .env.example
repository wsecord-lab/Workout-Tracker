# Required: Prisma database URL (SQLite file path with file: prefix)
# Path is relative to prisma/schema.prisma (so ./dev.db = prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Optional: Override path to SQLite DB file (used by backup script; falls back to parsing DATABASE_URL)
# SQLITE_DB_PATH="./prisma/dev.db"

# Optional: Shared secret for access gate. If set in production, all requests must include
# header "x-access-token: <value>" or cookie "access_token=<value>"
# ACCESS_TOKEN=""
