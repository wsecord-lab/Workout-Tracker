# Required: PostgreSQL connection string (e.g. from Neon, Supabase, Railway)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional: Shared secret for access gate. If set in production, all requests must include
# header "x-access-token: <value>" or cookie "access_token=<value>"
# ACCESS_TOKEN=""

# Auth (NextAuth): required in production. Optional locally (dev fallback exists).
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Optional: set for local preview if redirects fail (use your dev server port)
# AUTH_URL="http://localhost:3000"
