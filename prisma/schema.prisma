generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled Postgres URL for migrations (required on Neon when DATABASE_URL uses the pooler).
  directUrl = env("DIRECT_URL")
}

// —— Auth (Auth.js / NextAuth v5) ———
enum Role {
  TRAINER
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role
  /// True when a trainer set a temporary password; cleared after the user changes it.
  mustChangePassword Boolean @default(false)
  createdAt     DateTime  @default(now())
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  clients       Client[]
  ownedClients  Client[]         @relation("ClientTrainer")
  trainerExerciseCatalog TrainerExerciseCatalogItem[]
  warmupBlocks  WarmupBlock[]
  workoutTemplates WorkoutTemplate[]
  measurements  Measurement[]
  assignedAsTrainer TrainerClient[]  @relation("TrainerAssignments")
  assignedClients   TrainerClient[]  @relation("AssignedClients")
  passwordResetTokens PasswordResetToken[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  mcpChanges    McpChange[]
  oauthCodes    OAuthCode[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// —— App: Client profile (linked to User when role=client) ———
model Client {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  trainerId     String?
  trainer       User?     @relation("ClientTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  name          String
  age           Int
  heightCm      Float
  bodyWeightKg  Float
  sessions      WorkoutSession[]
  weightRecords ClientWeightRecord[]
  metricsCache  ClientMetricsCache[]
  restDays      ClientRestDay[]

  @@index([userId])
  @@index([trainerId])
}

model ClientRestDay {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

model ClientMetricsCache {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rangeKey    String   // e.g. "7d" | "30d" | "90d"
  computedAt  DateTime @default(now())
  payloadJson String   @db.Text

  @@unique([clientId, rangeKey])
  @@index([clientId])
}

model ClientWeightRecord {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weightKg  Float
  recordedAt DateTime @default(now())

  @@index([clientId, recordedAt])
}

model TrainerClient {
  id         String   @id @default(cuid())
  trainerId  String
  clientId   String
  trainer    User     @relation("TrainerAssignments", fields: [trainerId], references: [id], onDelete: Cascade)
  client     User     @relation("AssignedClients", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId])
}

model Measurement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float
  heightCm  Float
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

// —— Workouts (existing app) ———
model WorkoutSession {
  id            String       @id @default(cuid())
  name          String?
  /// Lowercased/whitespace-collapsed `name`, for "last Upper Body workout" matching.
  normalizedName String?
  notes         String?      @db.Text
  date          DateTime     @default(now())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercises     Exercise[]
  warmupBlockId String?
  warmupBlock   WarmupBlock? @relation(fields: [warmupBlockId], references: [id], onDelete: SetNull)
  /// Stamped when workout mode is first entered.
  startedAt     DateTime?
  finishedAt    DateTime?
  /// Set while the workout is paused (left active mode to edit). Null when running or never paused.
  pausedAt      DateTime?
  /// Accumulated seconds spent paused across pause/resume cycles. Cleared pause windows are folded in here.
  totalPausedSeconds Int @default(0)
  /// Manual duration override in seconds. Null = derive from startedAt/finishedAt (minus pauses).
  durationSeconds Int?

  @@index([clientId, date])
  @@index([clientId, normalizedName, date])
  @@index([warmupBlockId])
}

model WarmupBlock {
  id         String            @id @default(cuid())
  trainerId  String
  trainer    User              @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name       String
  isArchived Boolean           @default(false)
  items      WarmupBlockItem[]
  sessions   WorkoutSession[]
  createdAt  DateTime          @default(now())

  @@index([trainerId])
}

model WarmupBlockItem {
  id         String      @id @default(cuid())
  blockId    String
  block      WarmupBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  name       String
  details    String?
  orderIndex Int         @default(0)

  @@index([blockId])
}

model ExerciseCatalog {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  exercises Exercise[]
}

// Trainer-scoped master exercise list (each trainer has their own)
model TrainerExerciseCatalogItem {
  id             String   @id @default(cuid())
  trainerId      String
  trainer        User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([trainerId, normalizedName])
  @@index([trainerId])
}

model Exercise {
  id                  String           @id @default(cuid())
  name                String
  notes               String?          @db.Text
  sessionId           String
  session             WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  catalogExerciseId   String?
  catalogExercise     ExerciseCatalog? @relation(fields: [catalogExerciseId], references: [id], onDelete: SetNull)
  orderIndex          Int              @default(0)
  groupId             String?
  sets                Set[]
  deletedAt           DateTime?

  @@index([sessionId])
  @@index([catalogExerciseId])
}

model Set {
  id         String   @id @default(cuid())
  /// ACTUAL performed weight once completedAt is set; the TARGET while still planned.
  weightKg   Float
  /// ACTUAL performed reps once completedAt is set; the TARGET while still planned.
  reps       Int
  /// Snapshot of the planned target. Null for ad-hoc logged sets that were never planned.
  plannedWeightKg Float?
  plannedReps     Int?
  /// Null = planned but not performed. Non-null = actually done.
  completedAt DateTime?
  rpe        Float?
  notes      String?
  orderIndex Int      @default(0)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([exerciseId])
  @@index([exerciseId, orderIndex])
  @@index([exerciseId, completedAt])
}

// —— Workout Templates (trainer-scoped) ———
model WorkoutTemplate {
  id         String   @id @default(cuid())
  trainerId  String
  trainer    User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name       String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  items      WorkoutTemplateItem[]

  @@index([trainerId])
  @@index([trainerId, isArchived])
}

model WorkoutTemplateItem {
  id              String          @id @default(cuid())
  templateId      String
  orderIndex      Int
  exerciseName    String
  normalizedName  String
  /// When set with plannedWeightKg + plannedReps, apply creates that many planned sets.
  plannedSetCount Int?
  plannedWeightKg Float?
  plannedReps     Int?
  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@unique([templateId, orderIndex])
}

// —— MCP (AI tool access) ———
/// Secret key an AI app sends to reach the MCP endpoint. Only a SHA-256 hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  keyHash    String    @unique
  /// First few characters of the key, so a key can be recognised without revealing it.
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  /// Sign-in (OAuth) access tokens expire; manually created keys leave this null.
  expiresAt  DateTime?
  /// SHA-256 of the refresh token issued with an OAuth access token.
  refreshHash String?  @unique
  refreshExpiresAt DateTime?
  /// Which OAuth client (e.g. Claude) this token was issued to. Null for manual keys.
  oauthClientId String?
  changes    McpChange[]

  @@index([userId])
}

/// Every write made through the MCP, with the value before and after, so it can be reviewed and undone.
model McpChange {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId   String?
  apiKey     ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  tool       String
  /// "session" | "set" | "exercise"
  entityType String
  entityId   String
  sessionId  String?
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now())
  undoneAt   DateTime?

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

/// An AI app (e.g. Claude) that registered itself so people can sign in through it.
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String?
  redirectUris String[]
  createdAt    DateTime @default(now())
}

/// Short-lived, single-use code handed back after a person clicks Allow. Only its hash is stored.
model OAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}
