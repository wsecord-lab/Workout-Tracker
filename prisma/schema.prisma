generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// —— Auth (Auth.js / NextAuth v5) ———
enum Role {
  TRAINER
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role
  createdAt     DateTime  @default(now())
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  clients       Client[]
  ownedClients  Client[]         @relation("ClientTrainer")
  trainerExerciseCatalog TrainerExerciseCatalogItem[]
  measurements  Measurement[]
  assignedAsTrainer TrainerClient[]  @relation("TrainerAssignments")
  assignedClients   TrainerClient[]  @relation("AssignedClients")
  passwordResetTokens PasswordResetToken[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// —— App: Client profile (linked to User when role=client) ———
model Client {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  trainerId     String?
  trainer       User?     @relation("ClientTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  name          String
  age           Int
  heightCm      Float
  bodyWeightKg  Float
  sessions      WorkoutSession[]
  weightRecords ClientWeightRecord[]
  metricsCache  ClientMetricsCache[]

  @@index([userId])
  @@index([trainerId])
}

model ClientMetricsCache {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rangeKey    String   // e.g. "7d" | "30d" | "90d"
  computedAt  DateTime @default(now())
  payloadJson String   @db.Text

  @@unique([clientId, rangeKey])
  @@index([clientId])
}

model ClientWeightRecord {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weightKg  Float
  recordedAt DateTime @default(now())

  @@index([clientId, recordedAt])
}

model TrainerClient {
  id         String   @id @default(cuid())
  trainerId  String
  clientId   String
  trainer    User     @relation("TrainerAssignments", fields: [trainerId], references: [id], onDelete: Cascade)
  client     User     @relation("AssignedClients", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId])
}

model Measurement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float
  heightCm  Float
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

// —— Workouts (existing app) ———
model WorkoutSession {
  id         String    @id @default(cuid())
  name       String?
  date       DateTime  @default(now())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercises  Exercise[]

  @@index([clientId, date])
}

model ExerciseCatalog {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  exercises Exercise[]
}

// Trainer-scoped master exercise list (each trainer has their own)
model TrainerExerciseCatalogItem {
  id             String   @id @default(cuid())
  trainerId      String
  trainer        User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([trainerId, normalizedName])
  @@index([trainerId])
}

model Exercise {
  id                  String           @id @default(cuid())
  name                String
  sessionId           String
  session             WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  catalogExerciseId   String?
  catalogExercise     ExerciseCatalog? @relation(fields: [catalogExerciseId], references: [id], onDelete: SetNull)
  orderIndex          Int              @default(0)
  sets                Set[]
  deletedAt           DateTime?

  @@index([sessionId])
  @@index([catalogExerciseId])
}

model Set {
  id         String   @id @default(cuid())
  weightKg   Float
  reps       Int
  rpe        Float?
  notes      String?
  orderIndex Int      @default(0)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([exerciseId])
  @@index([exerciseId, orderIndex])
}

// —— Workout Templates (trainer-only, global) ———
model WorkoutTemplate {
  id         String   @id @default(cuid())
  name       String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  items      WorkoutTemplateItem[]

  @@index([isArchived])
}

model WorkoutTemplateItem {
  id           String          @id @default(cuid())
  templateId   String
  orderIndex   Int
  exerciseName String
  normalizedName String
  template     WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@unique([templateId, orderIndex])
}
